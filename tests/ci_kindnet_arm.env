# Throwaway continuous integration experiment configuration.
#
# Selects which arm of the kindnet processor quota experiment this branch runs.
#
#   control    kindnet-cni keeps the KinD default resource limit of 100m processor.
#   treatment  the processor limit is removed immediately after the cluster is
#              created. The request stays at 100m.
#
# Both arms are otherwise byte identical, so the only difference between the two
# branches of the experiment is the value on the next line.
CI_KINDNET_ARM=control
